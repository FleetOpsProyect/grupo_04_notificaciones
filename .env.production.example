# Copie como /opt/fleetops/.env en la EC2. Nunca versione este archivo.
NODE_ENV=production
PORT=3000
SERVICE_NAME=notification
LOG_LEVEL=info
TZ=America/Bogota
ENABLE_SWAGGER=false

# Imagen (el CD reemplaza IMAGE_TAG con el SHA desplegado)
IMAGE_REPOSITORY=camilom959/fleetops-notification-service
IMAGE_TAG=latest

# Firestore
FIREBASE_PROJECT_ID=fleetops-notificaciones
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/fleetops-notificaciones-firebase-adminsdk-fbsvc-083952c2cc.json

# AWS (rol IAM de la instancia; no configure claves estáticas)
AWS_REGION=us-east-2
SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/020882464612/notifications_queue.fifo
SQS_DLQ_URL=https://sqs.us-east-2.amazonaws.com/020882464612/notifications_dlq.fifo
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_NUMBER_OF_MESSAGES=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_RECEIVE_COUNT=4
SNS_NOTIFICATION_TOPIC_ARN=arn:aws:sns:us-east-2:020882464612:fleetops_notification_events.fifo

# Correo: console hasta cerrar Resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=notificaciones@example.invalid
EMAIL_TIMEOUT_MS=5000
EMAIL_RETRY_DELAYS_MS=30000,120000,600000
EMAIL_MAX_ATTEMPTS=4
EMAIL_CB_THRESHOLD=5
EMAIL_CB_RESET_MS=30000

# Despacho y outbox
DISPATCH_INTERVAL_MS=10000
DISPATCH_BATCH_SIZE=20
DISPATCH_LEASE_MS=60000
OUTBOX_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_MS=30000
OUTBOX_RETRY_DELAYS_MS=5000,30000,120000

# Consumidor
CONSUMER_RETRY_DELAYS_MS=2000,10000,30000

# Destinatarios por rol
RECIPIENT_FLEET_ADMINISTRATOR=admin@example.invalid
RECIPIENT_MAINTENANCE_TECHNICIAN=tecnico@example.invalid
RECIPIENT_MANAGEMENT=gerencia@example.invalid

READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
