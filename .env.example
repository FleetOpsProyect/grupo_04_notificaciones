# FleetOps Notification Service - configuración de ejemplo.
# Copie este archivo como .env y use valores inocuos en local.
# Nunca versione .env, credenciales ni correos personales reales.

NODE_ENV=development
PORT=3000
SERVICE_NAME=notification
LOG_LEVEL=info
TZ=America/Bogota
ENABLE_SWAGGER=true

# Firestore: en local use el emulador. En producción use credenciales externas.
FIREBASE_PROJECT_ID=demo-fleetops
# GOOGLE_APPLICATION_CREDENTIALS=.../silence
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Correo: console no envía correos reales.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=notificaciones@example.invalid
EMAIL_TIMEOUT_MS=5000
EMAIL_RETRY_DELAYS_MS=30000,120000,600000
EMAIL_MAX_ATTEMPTS=4
EMAIL_CB_THRESHOLD=5
EMAIL_CB_RESET_MS=30000

# Despacho.
DISPATCH_INTERVAL_MS=10000
DISPATCH_BATCH_SIZE=20
DISPATCH_LEASE_MS=60000

OUTBOX_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_MS=30000
OUTBOX_RETRY_DELAYS_MS=5000,30000,120000

# Consumidor.
CONSUMER_RETRY_DELAYS_MS=2000,10000,30000

# Destinatarios por rol. Use correos de prueba, nunca datos reales.
RECIPIENT_FLEET_ADMINISTRATOR=admin@example.invalid
RECIPIENT_MAINTENANCE_TECHNICIAN=tecnico@example.invalid
RECIPIENT_MANAGEMENT=gerencia@example.invalid

READINESS_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000

# AWS (SQS/SNS). En local apunte a LocalStack.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SQS
SQS_QUEUE_URL=
SQS_DLQ_URL=
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_NUMBER_OF_MESSAGES=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_RECEIVE_COUNT=4

# SNS
SNS_NOTIFICATION_TOPIC_ARN=
# Tópico lógico: fleetops_notification_events (ARN real termina en .fifo)
