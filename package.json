{
  "name": "fleetops-notification-service",
  "version": "1.0.0",
  "private": true,
  "description": "Arquetipo funcional del microservicio de Notificaciones de FleetOps (Grupo 04)",
  "main": "src/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:api": "jest test/api",
    "test:integration": "node scripts/run-kafka-integration.js",
    "test:integration:firestore": "node scripts/run-firestore-integration.js",
    "test:integration:all": "npm run test:integration && npm run test:integration:firestore",
    "test:e2e": "jest test/e2e --runInBand",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:validate": "node scripts/validate-openapi.js",
    "kafka:setup": "node scripts/kafka-setup.js",
    "kafka:publish": "node scripts/kafka-publish.js",
    "firestore:event": "node scripts/firestore-inspect-event.js",
    "firestore:cleanup": "node scripts/firestore-cleanup-event.js",
    "firestore:indexes": "node scripts/firestore-indexes.js"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "firebase-admin": "14.5.0",
    "helmet": "8.3.0",
    "kafkajs": "2.2.4",
    "opossum": "10.0.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "resend": "6.34.1",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1"
  }
}
